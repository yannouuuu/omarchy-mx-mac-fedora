#!/bin/bash

# omarchy:summary=Not available on Fedora Asahi — Limine bootloader is not used on Apple Silicon.
# omarchy:requires-sudo=true

# Fedora Asahi Remix uses U-Boot + m1n1 as the bootloader, not Limine.
# This command has no equivalent on Fedora Asahi and exits with an error.
echo "Error: Limine is not used on Fedora Asahi (bootloader is U-Boot + m1n1)." >&2
exit 1
