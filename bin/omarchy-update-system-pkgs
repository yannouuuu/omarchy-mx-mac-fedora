#!/bin/bash

# omarchy:summary=Update system packages with dnf
# omarchy:requires-sudo=true

set -e

echo -e "\e[32m\nUpdate system packages\e[0m"

dnf_args=()
if omarchy-hw-apple-silicon; then
  # On Apple Silicon the Quattro bundle packages are managed by the signed
  # bundle updater, not by a plain dnf upgrade. Exclude them here so they
  # don't get independently bumped by a COPR update.
  dnf_args+=(--exclude omarchy-keyring --exclude omarchy-settings-dev \
              --exclude omarchy-dev --exclude omarchy-nvim \
              --exclude quickshell --exclude ttf-jetbrains-mono-nerd-basic)
fi

# DNF handles conflict resolution interactively via its own prompts.
# Use -y for non-interactive mode; conflicts that require decisions will
# surface as dnf errors for the user to resolve manually.
if sudo env OMARCHY_UPDATE_DNF=1 dnf upgrade --refresh -y "${dnf_args[@]}"; then
  exit 0
fi

exit 1
