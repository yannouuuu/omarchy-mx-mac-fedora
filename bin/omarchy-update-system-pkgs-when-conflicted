#!/bin/bash

# omarchy:summary=Not available on Fedora Asahi — DNF handles package conflicts differently.
# omarchy:hidden=true

# This script handled pacman-specific conflict resolution (unowned files, package conflicts).
# On Fedora Asahi, DNF manages package conflicts through its own transaction resolver.
# If a dnf upgrade fails, review the dnf output and resolve conflicts manually.
echo "Error: omarchy-update-system-pkgs-when-conflicted is not applicable on Fedora Asahi." >&2
echo "Review the dnf upgrade output and resolve package conflicts manually." >&2
exit 1

