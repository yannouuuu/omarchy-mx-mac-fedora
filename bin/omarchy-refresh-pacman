#!/bin/bash

# omarchy:summary=Not available on Fedora Asahi — Omarchy package channels use dnf and COPR, not pacman mirrors.
# omarchy:requires-sudo=true

# On Fedora Asahi, package management uses dnf with COPR repositories.
# There is no pacman.conf or mirrorlist equivalent.
# To refresh repository metadata and upgrade, use:
#   omarchy update
# To configure COPR repositories, see:
#   install/helpers/dnf-copr.sh
echo "Error: omarchy-refresh-pacman is not available on Fedora Asahi." >&2
echo "Use 'omarchy update' to update packages via dnf." >&2
exit 1
