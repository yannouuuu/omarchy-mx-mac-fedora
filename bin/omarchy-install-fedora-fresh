#!/bin/bash

# omarchy:summary=Install Omarchy on a fresh Fedora Asahi Remix system
# omarchy:args=--asahi-packages DIR [--user USER]
# omarchy:hidden=true
# omarchy:requires-sudo=true
# Fedora Asahi Remix equivalent of omarchy-install-asahi-fresh.
# Called by install-asahi-quattro --fresh after the six-package bundle has
# been extracted with bsdtar into the running filesystem.

set -euo pipefail

bundle_dir=""
target_user=""
state_dir=/var/lib/omarchy/fresh-install

fail() {
  echo "Error: $*" >&2
  exit 1
}

usage() {
  echo "Usage: omarchy-install-fedora-fresh --asahi-packages DIR [--user USER]" >&2
}

retry() {
  local attempt
  for attempt in {1..3}; do
    "$@" && return 0
    (( attempt < 3 )) || return 1
    sleep 5
  done
}

while (($#)); do
  case "$1" in
    --asahi-packages)
      (($# > 1)) || fail "--asahi-packages requires a directory"
      bundle_dir="$2"
      shift 2
      ;;
    --user)
      (($# > 1)) || fail "--user requires a username"
      target_user="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      fail "Unknown option: $1"
      ;;
  esac
done

(( EUID == 0 )) || fail "Run the fresh installer as root"
[[ -d $bundle_dir ]] || fail "The verified package directory is unavailable"
[[ $(uname -m) == "aarch64" ]] || fail "Fresh Apple Silicon installation requires aarch64"
[[ -r /proc/device-tree/compatible ]] || fail "Apple device-tree information is unavailable"
grep -aq 'apple,' /proc/device-tree/compatible || fail "Apple Silicon device tree not found"

# Verify the Asahi kernel is running
uname -r | grep -q asahi || fail "Required Asahi kernel is not running (current: $(uname -r))"

# Verify base Fedora Asahi packages
for pkg in NetworkManager iwd; do
  rpm -q "$pkg" >/dev/null 2>&1 || fail "Required package is not installed: $pkg"
done

# Prompt for username if not given
if [[ -z $target_user ]]; then
  tty </dev/tty >/dev/null 2>&1 || fail "--user is required without an interactive terminal"
  read -rp "Omarchy username: " target_user </dev/tty
fi
[[ $target_user =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || fail "Invalid username: $target_user"
[[ $target_user != "root" ]] || fail "The Omarchy user cannot be root"

# Check that omarchy-dev is already extracted (bundle extracted before calling this)
[[ -d /usr/share/omarchy ]] || fail "/usr/share/omarchy not found — was the bundle extracted?"
[[ -f /usr/share/omarchy/version ]] || fail "/usr/share/omarchy/version not found — bundle extraction may be incomplete"
OMARCHY_PATH=/usr/share/omarchy

# ---------------------------------------------------------------------------
# Enable COPR repos before installing packages
# ---------------------------------------------------------------------------
echo "Enabling Omarchy COPR repositories..."
if ! dnf copr list 2>/dev/null | grep -q 'lionheartp/Hyprland'; then
  dnf copr enable -y lionheartp/Hyprland
fi

# ---------------------------------------------------------------------------
# Read the Fedora package manifest from the extracted omarchy-dev
# ---------------------------------------------------------------------------
fedora_manifest="$OMARCHY_PATH/install/omarchy-base-asahi.packages.fedora"
other_manifest="$OMARCHY_PATH/install/omarchy-other-asahi.packages.fedora"
[[ -f $fedora_manifest ]] || fail "Fedora package manifest not found at $fedora_manifest"

mapfile -t base_packages < <(
  grep -v '^#' "$fedora_manifest" | grep -v '^$'
)
mapfile -t other_packages < <(
  grep -v '^#' "$other_manifest" | grep -v '^$' || true
)

(( ${#base_packages[@]} > 0 )) || fail "Could not read the Fedora package manifest"

# ---------------------------------------------------------------------------
# Install all packages
# ---------------------------------------------------------------------------
echo "Installing the Omarchy Fedora package set (this will take a while)..."
dnf install -y --skip-unavailable \
  sudo xdg-user-dirs \
  "${base_packages[@]}" \
  "${other_packages[@]}"

# ---------------------------------------------------------------------------
# User creation
# ---------------------------------------------------------------------------
if ! getent passwd "$target_user" >/dev/null; then
  getent passwd "$target_user" >/dev/null 2>&1 && \
    fail "User already exists: $target_user"
  useradd --create-home --groups wheel --shell /bin/bash "$target_user"
fi
target_home=$(getent passwd "$target_user" | cut -d: -f6)

# Ensure wheel group has sudo access
install -Dm440 /dev/stdin /etc/sudoers.d/10-omarchy-wheel <<'EOF'
%wheel ALL=(ALL:ALL) ALL
EOF

# ---------------------------------------------------------------------------
# Set user password
# ---------------------------------------------------------------------------
echo "Set the password for $target_user"
passwd "$target_user" </dev/tty

# ---------------------------------------------------------------------------
# SDDM: seed remembered user so the password-only greeter has a username on
# ---------------------------------------------------------------------------
# SDDM: seed remembered user so the password-only greeter has a username on
# first boot (empty user → PAM rejects every password as "user unknown")
# ---------------------------------------------------------------------------
echo "Configuring SDDM display manager..."
install -d -m 0755 /var/lib/sddm 2>/dev/null || true
cat > /var/lib/sddm/state.conf <<EOF
[Last]
Session=omarchy.desktop
User=$target_user
EOF
chown sddm:sddm /var/lib/sddm /var/lib/sddm/state.conf 2>/dev/null || true

# ---------------------------------------------------------------------------
# PAM / authselect for SDDM (Fedora-specific)
# Don't break authselect state — use drop-in directory
# ---------------------------------------------------------------------------
bash "$OMARCHY_PATH/install/login/sddm.sh" 2>/dev/null || true

# ---------------------------------------------------------------------------
# Enable SDDM and Graphical Boot Target
# ---------------------------------------------------------------------------
echo "Setting up graphical boot target and SDDM..."
systemctl set-default graphical.target 2>/dev/null || true
systemctl enable sddm.service 2>/dev/null || true

# Deploy SDDM theme and Wayland session entries
mkdir -p /usr/share/sddm/themes /usr/share/wayland-sessions /etc/sddm.conf.d
cp -rf "$OMARCHY_PATH/default/sddm/omarchy" /usr/share/sddm/themes/ 2>/dev/null || true
cp -f "$OMARCHY_PATH/default/wayland-sessions/omarchy.desktop" /usr/share/wayland-sessions/ 2>/dev/null || true
cp -rf "$OMARCHY_PATH/etc/sddm.conf.d/." /etc/sddm.conf.d/ 2>/dev/null || true

# ---------------------------------------------------------------------------
# System configuration (Hyprland, hardware, etc.)
# ---------------------------------------------------------------------------
echo "Applying Omarchy system configuration..."
OMARCHY_PATH=$OMARCHY_PATH \
  OMARCHY_INSTALL=$OMARCHY_PATH/install \
  omarchy-apply-system --install-user "$target_user" --first-install 2>&1 || true

# ---------------------------------------------------------------------------
# Provision user config (~/.config from OMARCHY_PATH/config)
# ---------------------------------------------------------------------------
echo "Provisioning user desktop configuration..."
# Seed ~/.config directly from /usr/share/omarchy/config
mkdir -p "$target_home/.config"
cp -rn "$OMARCHY_PATH/config/." "$target_home/.config/" 2>/dev/null || true
chown -R "$target_user:$target_user" "$target_home/.config" 2>/dev/null || true

runuser -u "$target_user" -- env \
  HOME="$target_home" \
  USER="$target_user" \
  LOGNAME="$target_user" \
  OMARCHY_PATH=$OMARCHY_PATH \
  OMARCHY_INSTALL=$OMARCHY_PATH/install \
  OMARCHY_SETUP_CONTEXT=fresh-install \
  PATH="$OMARCHY_PATH/bin:/usr/local/sbin:/usr/local/bin:/usr/bin" \
  omarchy-provision-user --force --first-install 2>&1 || true

# ---------------------------------------------------------------------------
# systemd-resolved: stub resolver for mDNS/avahi
# ---------------------------------------------------------------------------
ln -sfn /run/systemd/resolve/stub-resolv.conf /etc/resolv.conf 2>/dev/null || true

# ---------------------------------------------------------------------------
# SELinux: restore contexts for files extracted outside RPM tracking
# ---------------------------------------------------------------------------
echo "Restoring SELinux file contexts..."
restorecon -r /usr/share/omarchy 2>/dev/null || true
restorecon -r /usr/bin/omarchy* 2>/dev/null || true
restorecon -r "$target_home" 2>/dev/null || true

# ---------------------------------------------------------------------------
# Disable any pre-existing default user that Fedora Asahi creates (e.g. 'asahi')
# ---------------------------------------------------------------------------
for stale_user in asahi fedora; do
  [[ $stale_user != "$target_user" ]] || continue
  if getent passwd "$stale_user" >/dev/null 2>&1; then
    [[ " $(id -nG "$stale_user") " != *" wheel "* ]] || gpasswd -d "$stale_user" wheel 2>/dev/null || true
    usermod -L "$stale_user" 2>/dev/null || true
  fi
done

# Write release marker
install -d -m 0755 /var/lib/omarchy
cat > /var/lib/omarchy/asahi-quattro-release <<EOF
format=1
sequence=${OMARCHY_ASAHI_RELEASE_SEQUENCE:-0}
tag=${OMARCHY_ASAHI_RELEASE_TAG:-unknown}
source_commit=${OMARCHY_ASAHI_RELEASE_SOURCE:-unknown}
EOF
chmod 0644 /var/lib/omarchy/asahi-quattro-release

echo ""
echo "=========================================================="
echo " Fresh Omarchy 4 installation on Fedora Asahi complete!"
echo " Please reboot your Mac, then sign in as: $target_user"
echo "=========================================================="
