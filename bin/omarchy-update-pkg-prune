#!/bin/bash

# omarchy:summary=Prune superseded versions from the dnf package cache
# omarchy:requires-sudo=true

set -e

# DNF does not have a paccache equivalent, but dnf clean packages removes
# cached packages that are no longer available in any enabled repository.
# This keeps the cache lean before the upgrade runs.
echo -e "\e[32m\nPrune package cache\e[0m"
sudo dnf clean packages 2>/dev/null || echo -e "\e[33mCould not prune the package cache.\e[0m" >&2
echo
