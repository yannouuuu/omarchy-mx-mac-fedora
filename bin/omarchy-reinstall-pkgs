#!/bin/bash

# omarchy:summary=Reinstall all default Omarchy packages from dnf
# omarchy:requires-sudo=true

set -e

# Refresh DNF repository metadata
sudo dnf makecache --refresh

# Ensure all packages are installed from the Fedora manifest.
# Falls back to the base Asahi manifest if the Fedora-specific one is missing.
fedora_manifest="$OMARCHY_PATH/install/omarchy-base-asahi.packages.fedora"
arch_manifest="$OMARCHY_PATH/install/omarchy-base-asahi.packages"

if [[ -f $fedora_manifest ]]; then
  mapfile -t packages < <(grep -v '^#' "$fedora_manifest" | grep -v '^$')
else
  echo "Warning: Fedora package manifest not found, falling back to Arch manifest (names may not match)" >&2
  mapfile -t packages < <(grep -v '^#' "$arch_manifest" | grep -v '^$')
fi

sudo dnf install -y --skip-unavailable "${packages[@]}"
