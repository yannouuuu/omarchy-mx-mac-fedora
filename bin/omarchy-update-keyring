#!/bin/bash

# omarchy:summary=Ensure the Omarchy GPG key is imported in the RPM keyring and refresh repo metadata
# omarchy:requires-sudo=true

# Fingerprint of the Omarchy release signing key (same key as used for the bundle).
# Source: https://raw.githubusercontent.com/yannouuuu/omarchy-mx-mac-fedora/main/default/omarchy-release.gpg
trusted_fingerprint=054BDF38F9C8208EDAF66FCBD64CF9AD7ABB2D60

if omarchy-hw-apple-silicon; then
  # On Apple Silicon the Omarchy GPG key must be present in the RPM keyring.
  # It is imported during the fresh install. If it is missing, the bundle
  # updater cannot verify signed packages.
  if ! rpm -q gpg-pubkey 2>/dev/null | grep -qi "${trusted_fingerprint:(-8,,)}"; then
    echo "The trusted Omarchy RPM signing key must be imported. Run:" >&2
    echo "  sudo rpm --import \$OMARCHY_PATH/default/omarchy-release.gpg" >&2
    exit 1
  fi
fi

# Refresh DNF repository metadata so subsequent installs use current data.
echo -e "\e[32m\nRefresh DNF repository metadata\e[0m"
sudo dnf makecache --refresh >/dev/null 2>&1 || true
echo "Repository metadata refreshed"
