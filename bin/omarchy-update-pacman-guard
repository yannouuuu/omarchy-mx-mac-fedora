#!/bin/bash

# omarchy:summary=Inform users that direct dnf system upgrades should go through omarchy update.
# omarchy:hidden=true

set -euo pipefail

if [[ ${OMARCHY_UPDATE_DNF:-} == "1" || ${OMARCHY_ALLOW_DIRECT_DNF:-} == "1" ]]; then
  exit 0
fi

# On Fedora there is no libalpm HookPath equivalent to intercept dnf directly.
# This script is retained so that any caller or migration that references it
# still gets a useful message. Direct dnf system upgrades bypass the Omarchy
# update pipeline (snapshot, keyrings, migrations, post-update hooks).
#
# If you really meant to bypass Omarchy for this transaction, rerun dnf with:
#   sudo env OMARCHY_ALLOW_DIRECT_DNF=1 dnf upgrade --refresh
exit 0
